---
config:
  theme: base
  fontFamily: 'Helvetica, Arial, sans-serif'
  themeVariables:
    fontFamily: 'Helvetica, Arial, sans-serif'
    fontSize: 15px
    lineColor: '#1f2328'
    primaryTextColor: '#1f2328'
    edgeLabelBackground: '#ffffff'
  flowchart:
    curve: linear
    nodeSpacing: 40
    rankSpacing: 55
    padding: 12
    wrappingWidth: 420
---
flowchart TD
  begin([" Begin start<br/>phase "]):::terminal

  subgraph warmUpRow [" "]
    direction LR
    warmUp[" Warm up<br/>application "]:::step
    warmUpDetails[["- Execute provider's start method<br/>- Run starting hooks<br/>- Import preload files"]]:::details
    warmUp --> warmUpDetails
  end

  startApp[/" Start Application "/]:::action

  subgraph postStartRow [" "]
    direction LR
    postStart[" Post-start phase "]:::step
    postStartDetails[["- Execute provider's ready method<br/>- Run ready hooks"]]:::details
    postStart --> postStartDetails
  end

  ready([" Application<br/>ready "]):::terminal

  begin -- "state:booted" --> warmUpRow
  warmUpRow -- "state:warmed" --> startApp
  startApp --> postStartRow
  postStartRow --> ready

  classDef terminal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
  classDef step fill:#f5f6f7,stroke:#dcdfe3,stroke-width:2px
  classDef details fill:#a9d6f5,stroke:#0e8ce4,stroke-width:2px,text-align:left
  classDef action fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

  style warmUpRow fill:none,stroke:none
  style postStartRow fill:none,stroke:none
